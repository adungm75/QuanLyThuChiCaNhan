# Ứng Dụng Quản Lý Chi Tiêu Cá Nhân - Environment Config Template
# HƯỚNG DẪN: Sao chép file này thành .env và điền các giá trị thực tế của bạn
# LƯU Ý BẢO MẬT: Không bao giờ commit file .env chứa thông tin bí mật lên Git!

# Môi trường chạy ứng dụng: development | staging | production
APP_ENV=development

# Tên ứng dụng hiển thị
APP_TITLE=Quản Lý Chi Tiêu Cá Nhân

# Cấu hình API Backend (khi tích hợp máy chủ đồng bộ dữ liệu)
API_BASE_URL=https://api.expensetracker.local/v1
API_TIMEOUT_MS=5000

# Khóa bí mật API / Token xác thực (Placeholder mẫu)
API_SECRET_KEY=your_secret_api_key_here

# Cấu hình cờ tính năng (Feature Flags)
ENABLE_MOCK_ERROR_PLAYGROUND=true
ENABLE_DEBUG_LOGGING=true
